# Run `make setup` to generate local random secrets. Never commit .env.
NODE_ENV=development
# Bind-mounted relay keys remain private to the setup user.
FLARE_UID=1000
FLARE_GID=1000
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://flare:CHANGE_ME@postgres:5432/flare
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0
# Flare JWT signing secret (>=32 characters); independent from Novu.
JWT_SECRET=CHANGE_ME
# 32-byte base64 key for AES-256-GCM, independent from Novu.
FLARE_ENCRYPTION_KEY=CHANGE_ME
# Novu STORE_ENCRYPTION_KEY must be exactly 32 characters.
STORE_ENCRYPTION_KEY=CHANGE_ME
NOVU_JWT_SECRET=CHANGE_ME
NOVU_SECRET_KEY=CHANGE_ME
NOVU_API_URL=http://novu-api:3000
# Browser-reachable self-hosted Inbox endpoints (never Novu Cloud).
NOVU_PUBLIC_API_URL=http://localhost:3000/novu
NOVU_PUBLIC_WS_URL=http://localhost:3002
NOVU_DEVELOPMENT_API_KEY=
NOVU_PRODUCTION_API_KEY=
NOVU_APPLICATION_IDENTIFIER=
NOVU_MONGO_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=flare
S3_ACCESS_KEY=flare
S3_SECRET_KEY=CHANGE_ME
TRANSPORT=postal
# Optional ordered failover list, e.g. postal,ses
TRANSPORT_PRIORITY=
POSTAL_API_URL=http://postal:5000
POSTAL_API_KEY=
POSTAL_HOSTNAME=postal.localhost
POSTAL_DB_PASSWORD=CHANGE_ME
POSTAL_SPF_HOST=spf.postal.localhost
POSTAL_RETURN_PATH=rp.postal.localhost
POSTAL_WEBHOOK_PUBLIC_KEY_FILE=/app/ops/certs/postal-public.pem
POSTAL_WEBHOOK_KEY_ID=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARNS=
# `make setup -- --dev` uses Mailpit. Production uses Postal, optionally SES.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Set only when the upstream SMTP relay guarantees required TLS for final delivery.
SMTP_DELIVERY_TLS_REQUIRED=false
SMTP_RELAY_PORT=2525
SMTP_TLS_CERT=/app/ops/certs/relay.crt
SMTP_TLS_KEY=/app/ops/certs/relay.key
PUBLIC_API_URL=http://localhost:4000
TRACKING_URL=http://localhost:4000
# Optional operator-controlled DNS resolver IPs, comma separated (port syntax supported).
DOMAIN_DNS_SERVERS=
MAIL_ATTACHMENT_MAX_BYTES=10485760
MAIL_MIME_MAX_BYTES=26214400
API_BODY_LIMIT=40mb
API_RATE_LIMIT=10
API_RATE_BURST=10
AUTH_RATE_LIMIT=0.166667
AUTH_RATE_BURST=10
LOG_RETENTION_DAYS=30
# Exact origins for trusted internal webhook receivers; empty blocks private IPs.
WEBHOOK_ALLOWED_ORIGINS=
SEED_DOMAIN=notifications.example.com
SEED_SUBSCRIBER_EMAIL=demo@example.com
SEED_OWNER_EMAIL=owner@paretolabs.local
SEED_OWNER_PASSWORD=CHANGE_ME
SEED_API_KEY=CHANGE_ME
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Inbound raw MIME, decoded attachments, count and root headers (bytes except count)
INBOUND_MIME_LIMIT=26214400
INBOUND_ATTACHMENT_LIMIT=10485760
INBOUND_ATTACHMENT_COUNT=100
INBOUND_HEADER_LIMIT=131072
# Metrics remain disabled until a >=32-character bearer token is configured.
METRICS_TOKEN=
OTEL_SERVICE_NAME=flare
SHUTDOWN_TIMEOUT_MS=30000
# Trusted reverse proxy IP/CIDR list; never trust arbitrary public forwarding headers.
TRUST_PROXY=
# Enable only behind ingress overwriting X-Flare-Client-IP; see docs/staging.md.
FLARE_FORWARD_CLIENT_IP=false
