{
  "title": "Flare operations",
  "uid": "flare-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (service, status) (rate(flare_http_seconds_count[5m]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,service) (rate(flare_http_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Durable backlog (capped at 10001)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "flare_pending_operations", "legendFormat": "{{kind}}" }]
    },
    {
      "id": 4,
      "title": "Provider outcomes",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(provider,outcome) (rate(flare_provider_attempts_total[5m]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Resident memory",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "flare_process_resident_memory_bytes", "legendFormat": "{{service}}" }]
    },
    {
      "id": 6,
      "title": "Job failures / second",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(queue) (rate(flare_jobs_total{outcome=\"failed\"}[5m]))",
          "legendFormat": "{{queue}}"
        }
      ]
    }
  ]
}
