# Overlay these non-secret settings on ops/staging/env.example in the private .env.
# Use one exact Vercel production/custom dashboard origin; never a wildcard or preview.
# Select docker-compose.staging-split-web.yml after docker-compose.staging.yml.
STAGING_WEB_MODE=vercel
STAGING_DASHBOARD_HOST=flare.staging.example.com
STAGING_API_HOST=api.flare.staging.example.com
STAGING_WS_HOST=ws.flare.staging.example.com
STAGING_TRACKING_HOST=track.notifications.staging.example.com
WEB_ORIGIN=https://flare.staging.example.com
PUBLIC_API_URL=https://api.flare.staging.example.com
TRACKING_URL=https://api.flare.staging.example.com
NOVU_PUBLIC_API_URL=https://flare.staging.example.com/novu
NOVU_PUBLIC_WS_URL=https://ws.flare.staging.example.com
TRUST_PROXY=172.30.250.10
FLARE_FORWARD_CLIENT_IP=false
FLARE_DASHBOARD_INBOX_WS=true
NOVU_WS_URL=http://novu-ws:3002
# Generate a dedicated fdp_ + canonical base64 32-byte random key. Set it privately
# as FLARE_DASHBOARD_PROXY_SECRET on both the backend and Vercel server environment.
# Never use NEXT_PUBLIC_ or reuse JWT, encryption, database or provider credentials.
# Leave blank until generated: preflight refuses an unconfigured split deployment.
FLARE_DASHBOARD_PROXY_SECRET=
