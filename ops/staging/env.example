# Copy these non-secret settings into the staging checkout's private .env.
# Replace every example hostname; never copy development credentials.
NODE_ENV=production
STAGING_WEB_MODE=compose
STAGING_DASHBOARD_HOST=flare.staging.example.com
STAGING_API_HOST=api.flare.staging.example.com
STAGING_WS_HOST=ws.flare.staging.example.com
STAGING_TRACKING_HOST=track.notifications.staging.example.com
STAGING_ACME_EMAIL=operations@example.com
STAGING_SUBNET=172.30.250.0/24
STAGING_PROXY_IP=172.30.250.10
TRUST_PROXY=172.30.250.10,172.30.250.11
FLARE_FORWARD_CLIENT_IP=true
WEB_ORIGIN=https://flare.staging.example.com
PUBLIC_API_URL=https://api.flare.staging.example.com
TRACKING_URL=https://api.flare.staging.example.com
NOVU_PUBLIC_API_URL=https://flare.staging.example.com/novu
NOVU_PUBLIC_WS_URL=https://ws.flare.staging.example.com
TRANSPORT=postal
TRANSPORT_PRIORITY=postal
SEED_DOMAIN=notifications.staging.example.com
# Initial pilot uses password + MFA, email and Inbox; OIDC remains optional.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Internal service addresses in DATABASE_URL, REDIS_URL, S3_ENDPOINT and NOVU_API_URL stay internal.
# Configure TRANSPORT/TRANSPORT_PRIORITY and its credentials separately.
